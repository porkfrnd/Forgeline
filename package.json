{
  "name": "forgeline",
  "version": "0.1.0",
  "description": "A calm, visual way to manage git repositories on localhost.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "forgeline": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "vite",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.build.json",
    "build": "npm run build:web && npm run build:server",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.web.json",
    "lint": "eslint .",
    "lint:copy": "node scripts/lint-copy.js",
    "check:contrast": "node scripts/check-contrast.mjs",
    "test": "vitest run",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "verify": "npm run check:contrast && npm run typecheck && npm run lint && npm run lint:copy && npm run test && npm run test:e2e"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "chokidar": "^4.0.3",
    "commander": "^12.1.0",
    "hono": "^4.6.14",
    "open": "^10.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
